---
import { Font } from 'astro:assets'
import { ClientRouter } from 'astro:transitions'

type SEO = {
  title?: string
  description?: string
  image?: URL
  imageAlt?: string
  publishedAt?: string
  next?: string
  prev?: string
}
interface Props {
  seo?: SEO
  hasPageTitle?: Boolean
}

import '@/styles/global.scss'

const canonicalURL = new URL(Astro.url.pathname, Astro.site)

const locale = Astro.currentLocale
const openGraphLocale = locale.replace('-', '_')

const defaultSiteImage = new URL('sharing-image.jpg', Astro.site)
const defaultSiteImageAlt =
  'Stylized black lettering on a white background that says "Kneaded Words"'

const { seo = {}, hasPageTitle = false } = Astro.props

const date = new Date()

const HeaderTag = !hasPageTitle ? 'h1' : 'p'
---

<!doctype html>
<html lang={locale ?? 'en-CA'}>
  <head>
    <meta charset='utf-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1' />

    <title>{seo?.title}</title>
    {seo?.description && <meta name='description' content={seo?.description} />}

    <link rel='canonical' href={canonicalURL} />
    <link rel='sitemap' href='/sitemap-index.xml' />

    <meta property='og:title' content={seo?.title} />
    {
      seo?.description && (
        <meta property='og:description' content={seo?.description} />
      )
    }

    <meta property='og:locale' content={openGraphLocale ?? 'en_CA'} />
    <meta property='og:type' content='website' />
    <meta property='og:url' content={canonicalURL} />
    <meta property='og:image' content={seo?.image ?? defaultSiteImage} />
    <meta
      property='og:image:alt'
      content={seo?.imageAlt ?? defaultSiteImageAlt}
    />

    <meta name='twitter:card' content='summary_large_image' />
    <meta name='twitter:title' content={seo?.title} />
    {
      seo?.description && (
        <meta name='twitter:description' content={seo?.description} />
      )
    }
    <meta name='twitter:image' content={seo?.image ?? defaultSiteImage} />
    <meta
      name='twitter:image:alt'
      content={seo?.imageAlt ?? defaultSiteImageAlt}
    />

    {
      seo?.publishedAt && (
        <meta property='article:published_time' content={seo.publishedAt} />
      )
    }
    {seo?.next && <link rel='next' href={seo.next} />}
    {seo?.prev && <link rel='next' href={seo.prev} />}

    <meta name='theme-color' content='#FFFFFF' />
    <meta name='color-scheme' content='only light' />

    <link rel='icon' href='/favicon.ico' sizes='any' />
    <link rel='icon' href='/icon.svg' type='image/svg+xml' />
    <link rel='apple-touch-icon' href='/apple-touch-icon.png' />

    <link rel='manifest' href='/manifest.webmanifest' />

    <Font cssVariable='--primary-font' />
    <Font cssVariable='--secondary-font' />
    <Font cssVariable='--title-font' />
    <ClientRouter />
  </head>
  <body>
    <header>
      <HeaderTag class:list={'header-title'}>
        <a href='/'>Kneaded Words</a>
      </HeaderTag>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <nav>
        <ul>
          <li><a href='/'>Home</a></li>
          <li><a href='/category/'>Categories</a></li>
          <li><a href='/tag/'>Tags</a></li>
          <li>
            <a
              href='https://bsky.app/profile/vocame.bsky.social'
              target='_blank'
              rel='noopener nofollow noreferrer'
              title='Follow Nadia on BlueSky'
            >
              <svg
                xmlns='http://www.w3.org/2000/svg'
                viewBox='0 0 640 640'
                class:list={'icon'}
                aria-hidden='true'
              >
                <!--!Font Awesome Free v7.2.0 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2026 Fonticons, Inc.-->
                <path
                  d='M439.8 358.7C436.5 358.3 433.1 357.9 429.8 357.4C433.2 357.8 436.5 358.3 439.8 358.7zM320 291.1C293.9 240.4 222.9 145.9 156.9 99.3C93.6 54.6 69.5 62.3 53.6 69.5C35.3 77.8 32 105.9 32 122.4C32 138.9 41.1 258 47 277.9C66.5 343.6 136.1 365.8 200.2 358.6C203.5 358.1 206.8 357.7 210.2 357.2C206.9 357.7 203.6 358.2 200.2 358.6C106.3 372.6 22.9 406.8 132.3 528.5C252.6 653.1 297.1 501.8 320 425.1C342.9 501.8 369.2 647.6 505.6 528.5C608 425.1 533.7 372.5 439.8 358.6C436.5 358.2 433.1 357.8 429.8 357.3C433.2 357.7 436.5 358.2 439.8 358.6C503.9 365.7 573.4 343.5 593 277.9C598.9 258 608 139 608 122.4C608 105.8 604.7 77.7 586.4 69.5C570.6 62.4 546.4 54.6 483.2 99.3C417.1 145.9 346.1 240.4 320 291.1z'
                ></path>
              </svg>
            </a>
          </li>
        </ul>
      </nav>
      Copyright &copy; {date.getFullYear()} | Nadia Petrasiunas
    </footer>
    <script
      type='application/ld+json'
      set:html={JSON.stringify({
        '@context': 'https://www.schema.org',
        '@type': 'Person',
        '@id': `${Astro.site.href}#person`,
        name: 'Nadia Petrasiunas',
        nationality: 'Canadian',
        url: Astro.site.href,
        address: {
          '@type': 'PostalAddress',
          addressCountry: 'Canada',
        },
        sameAs: [
          'https://bsky.app/profile/vocame.bsky.social',
          'https://ca.linkedin.com/in/nadia-petrasiunas-09440079',
        ],
      })}
    />
    <script
      type='application/ld+json'
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        '@id': `${Astro.site.href}#website`,
        url: Astro.site.href,
        inLanguage: 'en-CA',
        author: {
          '@id': `${Astro.site.href}#person`,
          '@type': 'Person',
          name: 'Nadia Petrasiunas',
        },
      })}
    />
  </body>
</html>

<style>
  body {
    display: grid;
    grid-template-columns: 1fr minmax(auto, 75rem) 1fr;
    grid-template-rows: auto 1fr auto;
    grid-template-areas:
      'header header header'
      '. main .'
      'footer footer footer';
  }

  header {
    border-bottom: var(--display-border);
    padding: 1.5rem 2rem;
    text-align: center;
    background-color: #fff;
    grid-area: header;
    display: flex;
    flex-direction: column;
    gap: 1rem;

    @media (width >= 56.25rem) {
      padding: 2.5rem 2rem;
    }

    .header-title {
      font-family: var(--title-font);
      margin: 0;
      font-size: 1.5rem;

      a {
        text-decoration: none;
      }

      @media (width >= 56.25rem) {
        font-size: 3rem;
        line-height: 1.25;
      }
    }
  }

  main {
    padding: 2rem 0 0;
    grid-area: main;
    display: flex;
    flex-direction: column;
    gap: 2rem;

    @media (width >= 37.5rem) {
      padding: 2rem 2rem 0;
    }
  }

  footer {
    text-align: center;
    padding: 2rem;
    color: var(--link-color-hover);
    font-size: 0.8125rem;
    grid-area: footer;
    display: flex;
    flex-direction: column;
    gap: 1rem;

    nav ul {
      list-style: none;
      display: flex;
      justify-content: center;
      gap: 1rem;
      padding: 0;
      margin: 0;

      a {
        display: flex;
        align-items: center;
        height: 100%;
      }

      .icon {
        width: 0.8125rem;
        height: 0.8125rem;
      }
    }
  }
</style>
