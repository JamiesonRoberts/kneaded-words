---
import type { CollectionEntry } from 'astro:content'
type Post = CollectionEntry<'post'>

import { getCollection } from 'astro:content'

import Layout from '@/layouts/Layout.astro'
import Heading from '@/components/Heading.astro'
import GroupList from '@/components/GroupList.astro'

const posts = await getCollection('posts')

const detailedList = [
  ...new Set(
    posts
      .map((post: Post) => post.data?.tags)
      .filter(Boolean)
      .flat(),
  ),
]
  .sort()
  .map((tag) => {
    return {
      handle: tag,
      count: posts.filter((post: Post) => post.data?.tags?.includes(tag))
        .length,
    }
  })

const seo = {
  title: `List of Tags | Kneaded Words`,
}
---

<Layout seo={seo} hasPageTitle={true}>
  <Heading text={'List of Tags'} />

  <GroupList name='tags' list={detailedList} capitalize={false} />
</Layout>
