---
const { text, prefix, page = null } = Astro.props
---

<header>
  <h1>
    {prefix ? `${prefix}:` : null}
    {text}
  </h1>
  {
    page && (
      <small>
        Page {page.currentPage} of {page.lastPage}
      </small>
    )
  }
</header>

<style>
  header {
    border-left: 0.375rem solid var(--color);
    background-color: #fff;
    padding: 1rem 1.625rem;
    margin: 0 2rem;

    @media (width >= 37.5rem) {
      margin: 0;
    }

    h1 {
      margin: 0;
      font-size: 1.125rem;
    }

    small {
      line-height: 1;
    }
  }
</style>
